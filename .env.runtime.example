# Copy this file as .env.runtime and set your image names.

# Docker image names pushed to Docker Hub/GHCR
BACKEND_IMAGE=your-docker-user/nasheto-vreme-backend:latest
FRONTEND_IMAGE=your-docker-user/nasheto-vreme-frontend:latest

# Ports
BACKEND_PORT=8088
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Postgres
POSTGRES_DB=nasheto_vreme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Use a strong base64-encoded secret in production (replace this example)
APP_JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS1mb3Itand0LXNpZ25pbmctMjAyNg==

# Comma-separated list of allowed CORS origins
APP_CORS_ORIGINS=https://app.example.com

